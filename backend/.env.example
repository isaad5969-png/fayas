PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=change-this-secret-before-deploy
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Gmail — utilisez un mot de passe d'application (pas votre mot de passe Gmail)
# https://myaccount.google.com/apppasswords
GMAIL_USER=votre-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# URL du frontend (liens de réinitialisation de mot de passe)
FRONTEND_URL=https://votre-projet.vercel.app

# Téléphone (OTP) — laissez VIDE en démo (le code est renvoyé dans la réponse).
# Définissez-le pour brancher un vrai envoi SMS (Twilio/Vonage) et masquer le code.
SMS_PROVIDER=
